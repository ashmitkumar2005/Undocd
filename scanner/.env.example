# Required for both the scanner CLI and the Next.js /api/queue route
# Copy to .env and fill in real values. Never commit secrets.

# Groq — free tier, get one at https://console.groq.com
GROQ_API_KEY=

# Fine-scoped GitHub PAT with contents:write on ashmitkumar2005/Undocd
GITHUB_TOKEN=

# Repo coordinates
GITHUB_OWNER=ashmitkumar2005
GITHUB_REPO=Undocd
GITHUB_BRANCH=main

# Optional — defaults shown
LLM_MODEL=llama-3.3-70b-versatile
SCAN_TIMEOUT_MS=20000
