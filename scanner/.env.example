# Required for both the scanner CLI and the Next.js /api/queue route
# Copy to .env and fill in real values. Never commit secrets.

# Groq — free tier, get one at https://console.groq.com
GROQ_API_KEY=

# Fine-scoped GitHub PAT with contents:write on ashmitkumar2005/Undocd
GITHUB_TOKEN=

# Repo coordinates
GITHUB_OWNER=ashmitkumar2005
GITHUB_REPO=Undocd
GITHUB_BRANCH=main

# Optional — defaults shown
LLM_MODEL=llama-3.3-70b-versatile
SCAN_TIMEOUT_MS=20000

# Optional — override Playwright's bundled Chromium (Ubuntu 26.04 workaround)
# Example: CHROMIUM_PATH=/home/you/.cache/ms-playwright/chromium-1134/chrome-linux/chrome
CHROMIUM_PATH=
# Set CONTAINER=1 if Chrome's user-namespace sandbox isn't usable on this host
CONTAINER=
